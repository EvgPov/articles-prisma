generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id         Int        @id
  title      String
  body       String
  tags       String[]   @default([])
  likes      Int        @default(0)
  dislikes   Int        @default(0)
  views      Int        @default(0)
  userId     Int        @map("user_id")
  authorId   Int        @map("author_id")
  summary    String?
  legacyUser LegacyUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author     Author     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comments   Comment[]

  @@index([authorId])
  @@map("articles")
}

model Comment {
  id         Int        @id
  body       String
  likes      Int        @default(0)
  postId     Int        @map("post_id")
  userId     Int        @map("user_id")
  authorId   Int        @map("author_id")
  article    Article    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  legacyUser LegacyUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author     Author     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([postId])
  @@map("comments")
}

model LegacyUser {
  id        Int       @id
  username  String
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  articles  Article[]
  comments  Comment[]

  @@map("users")
}

model Author {
  id        Int       @id
  username  String
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  articles  Article[]
  comments  Comment[]

  @@map("authors")
}
