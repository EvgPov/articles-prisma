# Database connection string (required) for local development
# Copy into .env.local

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pr01_articles"

# Public URL of the app for Better Auth (npm run dev)
# In Docker Compose it is set in the compose files
BETTER_AUTH_URL=http://localhost:3002

# 1 = add artificial delays to see loading fallbacks; 0 = off (default).
DEMO_DELAY=0

# User name, password and db name for Docker Compose
# Copy into .env file next to compose.yaml
# The password is intentionally empty. Docker Compose will not start until you set it

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pr01_articles

# Version of the images for compose.prod.yaml: a git tag, e.g. v1.0.0
# Intentionally empty: the production stack will not start until you set it
RELEASE_TAG=

# Secret for signing session cookies (Better Auth), at least 32 characters
# Needed in .env.local (npm run dev) and in .env (Docker Compose)
# Generate a separate value for each file: openssl rand -base64 32
# Intentionally empty: the app will not start until you set it
# Changing it later signs out all users
BETTER_AUTH_SECRET=