# Database connection string (required) for local development
# Copy into .env.local

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pr01_articles"

# 1 = add artificial delays to see loading fallbacks; 0 = off (default).
DEMO_DELAY=0

# User name, password and db name for Docker Compose
# Copy into .env file next to compose.yaml
# The password is intentionally empty. Docker Compose will not start until you set it

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pr01_articles